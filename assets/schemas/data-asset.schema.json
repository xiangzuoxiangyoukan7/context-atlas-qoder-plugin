{
  "required": ["id", "type", "title", "status", "sources", "owner", "source_types", "independence_basis", "sensitivity", "retention", "last_updated"],
  "enums": {
    "type": ["data_asset"],
    "status": ["missing", "proposed", "approved", "conflicted", "stale", "superseded", "archived"],
    "sensitivity": ["public", "internal", "sensitive", "restricted", "missing"]
  },
  "list_enums": {
    "source_types": ["database", "api", "message", "file", "object_storage", "manual_input", "other"],
    "independence_basis": ["cross_feature", "cross_technical_object", "independent_owner", "independent_quality_policy", "independent_security_policy", "independent_retention", "missing"]
  },
  "patterns": {
    "id": "DATA-\\d{3}",
    "version": "\\d+\\.\\d+\\.\\d+",
    "content_revision": "\\d+",
    "last_updated": "\\d{4}-\\d{2}-\\d{2}"
  },
  "non_empty_lists": ["sources", "source_types", "independence_basis"],
  "unique_lists": ["sources", "source_types", "independence_basis"]
}
