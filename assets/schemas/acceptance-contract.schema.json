{
  "required": ["id", "type", "title", "status", "subject_id", "behavior_id", "verification_kind", "edge_case", "sources", "last_updated"],
  "enums": {
    "type": ["acceptance_contract"],
    "status": ["missing", "proposed", "approved", "conflicted", "stale", "superseded", "archived"],
    "approval_status": ["proposed", "approved", "rejected"],
    "lifecycle_status": ["candidate", "active", "deprecated", "retired"],
    "spec_readiness": ["draft", "clarifying", "ready", "blocked"],
    "verification_kind": ["automated", "manual", "inspection", "metric"]
  },
  "patterns": {"id": "(?:AC-[A-Z0-9]+-[0-9]{3}|(?:F\\d{2}|KB)-AC-[0-9]{2})", "last_updated": "\\d{4}-\\d{2}-\\d{2}"},
  "non_empty_lists": ["sources"],
  "unique_lists": ["sources"]
}
