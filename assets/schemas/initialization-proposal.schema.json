{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-atlas.dev/schemas/initialization-proposal.schema.json",
  "title": "Context Atlas Initialization Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "proposal_revision", "project", "facts", "unknowns", "conflicts"],
  "properties": {
    "operation": {"const": "initialize"},
    "proposal_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "id", "name", "knowledge_base_name"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^[^./\\\\][^/\\\\]*$"},
        "name": {"type": "string", "minLength": 1},
        "knowledge_base_name": {"type": "string", "pattern": "^doc-[^/\\\\]+$"},
        "workspace_profile": {"enum": ["standard", "obsidian"]}
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goals", "boundaries_in", "boundaries_out", "technology_stacks", "terms", "capabilities", "features", "modules", "interfaces", "databases", "external_dependencies", "tests", "adrs"],
      "properties": {
        "goals": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "boundaries_in": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "boundaries_out": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "technology_stacks": {"type": "array", "items": {"$ref": "#/$defs/technology"}},
        "terms": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "features": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "modules": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "interfaces": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "databases": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "external_dependencies": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "tests": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "adrs": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
      }
    },
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/open_item"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/open_item"}}
    ,"agent_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "filename"],
      "properties": {
        "host": {"enum": ["codex", "claude", "qoder", "trae"]},
        "filename": {"enum": ["AGENTS.md", "CLAUDE.md"]}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "observed_at", "confirmation_status"],
      "properties": {
        "type": {"enum": ["repository_file", "user_statement", "existing_document", "command_output", "ai_inference"]},
        "reference": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "confirmation_status": {"enum": ["observed", "confirmed"]},
        "confirmed_at": {"type": "string", "format": "date-time"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "status", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
        "value": {"type": "string", "minLength": 1},
        "status": {"enum": ["confirmed", "proposed"]},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "status", "source", "name", "version", "location", "purpose", "commands", "configuration"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
        "value": {"type": "string", "minLength": 1},
        "status": {"enum": ["confirmed", "proposed"]},
        "source": {"$ref": "#/$defs/source"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "commands": {"type": "array", "items": {"type": "string"}},
        "configuration": {"type": "string", "minLength": 1}
      }
    },
    "open_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "owner_action"],
      "properties": {
        "id": {"type": "string", "pattern": "^(UNKNOWN|CONFLICT)-[0-9]{3}$"},
        "question": {"type": "string", "minLength": 1},
        "owner_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
