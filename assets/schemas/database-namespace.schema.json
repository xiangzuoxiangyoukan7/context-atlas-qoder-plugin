{
  "required": ["id", "type", "title", "status", "namespace_kind", "physical_name", "owner", "sources", "rel_belongs_to", "last_updated"],
  "enums": {
    "type": ["database_namespace"],
    "status": ["missing", "proposed", "approved", "conflicted", "stale", "superseded", "archived"],
    "namespace_kind": ["schema", "user_schema", "mode", "namespace", "other"]
  },
  "patterns": {
    "id": "NS-[A-Z0-9-]+",
    "version": "\\d+\\.\\d+\\.\\d+",
    "content_revision": "\\d+",
    "last_updated": "\\d{4}-\\d{2}-\\d{2}"
  },
  "non_empty_lists": ["sources", "rel_belongs_to"],
  "unique_lists": ["sources", "rel_belongs_to"]
}
